@prefix gq:   <https://github.com/Kiyeon-Nam/game-qa/ontology#> .
@prefix gqr:  <https://github.com/Kiyeon-Nam/game-qa/rules#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sh:   <http://www.w3.org/ns/shacl#> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .

# 규칙 SHACL 형상. 규칙 정의는 ontology/1_rules/
# 파라미터는 검증 시 데이터로 추가: [] gqr:name "<파라미터>" ; gqr:value <값>
# 형상마다 질의가 읽는 값을 선언. 검증 전에 누락을 확인 (빠지면 위반이 조용히 바뀜)
#   gqr:param: 파라미터 이름
#   gqr:measures: 측정값. gqr:measurement 측정값 클래스, gqr:subject·gqr:object 인자의 개념 (값이 여럿이면 모두 만족)
#     주체·대상 개념을 만족하는 인스턴스 조합마다 측정값 필요. gqr:symmetric true면 두 방향 중 하나만 있으면 됨
# 대상은 결과 메시지로 전달: SHACL 결과 노드의 대상은 focusNode·value 둘뿐이고,
#   SELECT 변수를 결과에 넣는 sh:resultAnnotation(SHACL 1.2 초안의 선택 기능)은 pySHACL 미지원
# 결과 메시지 형식: "<규칙 ID> <대상 인스턴스 URI ...>". 대상 순서는 규칙 위반 조건의 변수 순서 (= SELECT 변수 순서)
# 거리가 같은 대상은 인스턴스 id 순으로 앞섬 (id = 인스턴스 URI의 "instance:" 뒤 정수)
# "|" 뒤의 대상은 순서가 없는 목록 (GROUP_CONCAT). 검증 결과에서 id 순으로 정렬

gqr:prefixes
    sh:declare [ sh:prefix "gq" ; sh:namespace "https://github.com/Kiyeon-Nam/game-qa/ontology#"^^xsd:anyURI ] ,
               [ sh:prefix "gqr" ; sh:namespace "https://github.com/Kiyeon-Nam/game-qa/rules#"^^xsd:anyURI ] ,
               [ sh:prefix "rdfs" ; sh:namespace "http://www.w3.org/2000/01/rdf-schema#"^^xsd:anyURI ] ,
               [ sh:prefix "xsd" ; sh:namespace "http://www.w3.org/2001/XMLSchema#"^^xsd:anyURI ] .

# R-001: Display ∧ World i에 대해 distance(i, e) ≤ search_radius인 Entity e가 없음
#   제외: touches(i, ScreenBounds), foreground_coverage(i) ≥ foreground_cover_min
gqr:R-001 a sh:NodeShape ;
    gqr:param "search_radius", "foreground_cover_min" ;
    gqr:measures [ gqr:measurement gq:Distance ; gqr:subject gq:Display, gq:World ; gqr:object gq:Entity ] ,
                 [ gqr:measurement gq:ForegroundCoverage ; gqr:subject gq:Display, gq:World ] ;
    sh:targetClass gq:Display ;
    sh:sparql [
        sh:prefixes gqr:prefixes ;
        sh:message "R-001 {$this}" ;
        sh:select """
            SELECT $this WHERE {
                $this a gq:World .
                ?p1 gqr:name "search_radius" ; gqr:value ?radius .
                ?p2 gqr:name "foreground_cover_min" ; gqr:value ?cover .
                FILTER NOT EXISTS {
                    ?m gq:measuredSubject $this ; a gq:Distance ; gq:measuredObject ?e ; gq:value ?d .
                    ?e a gq:Entity .
                    FILTER (?d <= ?radius)
                }
                FILTER NOT EXISTS { $this gq:touches ?s . ?s a gq:ScreenBounds }
                FILTER NOT EXISTS {
                    ?f gq:measuredSubject $this ; a gq:ForegroundCoverage ; gq:value ?c .
                    FILTER (?c >= ?cover)
                }
            }""" ] .

# R-002: represents(i, e)에 대해 attach_distance < distance(i, e) ≤ search_radius
#   두 대상 사이에 떠 있는 경우(R-003 조건 1)는 제외
#   R-003 조건 1의 존재 판정: 가장 가까운 대상 e1(distance d1)과 다른 대상 e2에 대해 d1 / distance(i, e2) ≥ midpoint_ratio인 e2가 있으면
#   두 번째로 가까운 대상도 조건을 만족하므로 두 번째 대상을 찾지 않음
gqr:R-002 a sh:NodeShape ;
    gqr:param "attach_distance", "search_radius", "midpoint_ratio" ;
    gqr:measures [ gqr:measurement gq:Distance ; gqr:subject gq:Display, gq:World ; gqr:object gq:Entity ] ;
    sh:targetClass gq:Display ;
    sh:sparql [
        sh:prefixes gqr:prefixes ;
        sh:message "R-002 {$this} {?e}" ;
        sh:select """
            SELECT $this ?e WHERE {
                $this a gq:World ; gq:represents ?e .
                ?m gq:measuredSubject $this ; a gq:Distance ; gq:measuredObject ?e ; gq:value ?d .
                ?p1 gqr:name "attach_distance" ; gqr:value ?attach .
                ?p2 gqr:name "search_radius" ; gqr:value ?radius .
                ?p3 gqr:name "midpoint_ratio" ; gqr:value ?ratio .
                FILTER (?d > ?attach && ?d <= ?radius)
                { SELECT $this (MIN(?dd) AS ?d1) WHERE { ?mm gq:measuredSubject $this ; a gq:Distance ; gq:value ?dd } GROUP BY $this }
                FILTER NOT EXISTS {
                    ?m1 gq:measuredSubject $this ; a gq:Distance ; gq:measuredObject ?e1 ; gq:value ?d1 .
                    ?m2 gq:measuredSubject $this ; a gq:Distance ; gq:measuredObject ?e2 ; gq:value ?d2 .
                    FILTER (?d1 > ?attach && ?e2 != ?e1 && ?d1 / ?d2 >= ?ratio)
                }
            }""" ] .

# R-003 조건 1: 가장 가까운 대상과의 distance가 attach_distance를 넘는 Display ∧ World i가
#   가장 가까운 두 대상 e1, e2에 대해 distance(i, e1) / distance(i, e2) ≥ midpoint_ratio
gqr:R-003-midpoint a sh:NodeShape ;
    gqr:param "attach_distance", "midpoint_ratio" ;
    gqr:measures [ gqr:measurement gq:Distance ; gqr:subject gq:Display, gq:World ; gqr:object gq:Entity ] ;
    sh:targetClass gq:Display ;
    sh:sparql [
        sh:prefixes gqr:prefixes ;
        sh:message "R-003 {$this} {?e1} {?e2}" ;
        sh:select """
            SELECT $this ?e1 ?e2 WHERE {
                $this a gq:World .
                ?p1 gqr:name "attach_distance" ; gqr:value ?attach .
                ?p2 gqr:name "midpoint_ratio" ; gqr:value ?ratio .
                { SELECT $this (MIN(?d) AS ?d1) WHERE { ?m gq:measuredSubject $this ; a gq:Distance ; gq:value ?d } GROUP BY $this }
                FILTER (?d1 > ?attach)
                ?m1 gq:measuredSubject $this ; a gq:Distance ; gq:measuredObject ?e1 ; gq:value ?d1 .
                BIND (xsd:integer(STRAFTER(STR(?e1), "instance:")) AS ?k1)
                FILTER NOT EXISTS {
                    ?m0 gq:measuredSubject $this ; a gq:Distance ; gq:measuredObject ?e0 ; gq:value ?d1 .
                    FILTER (xsd:integer(STRAFTER(STR(?e0), "instance:")) < ?k1)
                }
                ?m2 gq:measuredSubject $this ; a gq:Distance ; gq:measuredObject ?e2 ; gq:value ?d2 .
                BIND (xsd:integer(STRAFTER(STR(?e2), "instance:")) AS ?k2)
                FILTER (?e2 != ?e1 && ?d1 / ?d2 >= ?ratio)
                FILTER NOT EXISTS {
                    ?m3 gq:measuredSubject $this ; a gq:Distance ; gq:measuredObject ?e3 ; gq:value ?d3 .
                    FILTER (?e3 != ?e1 && (?d3 < ?d2 || (?d3 = ?d2 && xsd:integer(STRAFTER(STR(?e3), "instance:")) < ?k2)))
                }
            }""" ] .

# R-003 조건 2: 한 대상 e에 distance(i, e) ≤ attach_distance인 Display ∧ World 중 같은 하위 개념이 2개 이상
#   하위 개념: 역할 축에서 Display의 하위 클래스. 대상과 하위 개념마다 위반 1건
gqr:R-003-duplicate a sh:NodeShape ;
    gqr:param "attach_distance" ;
    gqr:measures [ gqr:measurement gq:Distance ; gqr:subject gq:Display, gq:World ; gqr:object gq:Entity ] ;
    sh:targetClass gq:Entity ;
    sh:sparql [
        sh:prefixes gqr:prefixes ;
        sh:message "R-003 {$this} | {?displays}" ;
        sh:select """
            SELECT $this (GROUP_CONCAT(STR(?i); separator=" ") AS ?displays) WHERE {
                ?p gqr:name "attach_distance" ; gqr:value ?attach .
                ?m gq:measuredObject $this ; a gq:Distance ; gq:value ?d ; gq:measuredSubject ?i .
                FILTER (?d <= ?attach)
                ?i a gq:World, ?k .
                ?k rdfs:subClassOf gq:Display ; gq:axis "역할" .
            } GROUP BY $this ?k HAVING (COUNT(?i) >= 2)""" ] .

# R-004: Character c에 대해 overlap_ratio(c) > char_terrain_overlap_max
gqr:R-004 a sh:NodeShape ;
    gqr:param "char_terrain_overlap_max" ;
    gqr:measures [ gqr:measurement gq:OverlapRatio ; gqr:subject gq:Character ] ;
    sh:targetClass gq:Character ;
    sh:sparql [
        sh:prefixes gqr:prefixes ;
        sh:message "R-004 {$this}" ;
        sh:select """
            SELECT $this WHERE {
                ?m gq:measuredSubject $this ; a gq:OverlapRatio ; gq:value ?v .
                ?p gqr:name "char_terrain_overlap_max" ; gqr:value ?max .
                FILTER (?v > ?max)
            }""" ] .

# R-005: LooseObject o에 대해 overlap_ratio(o) > item_terrain_overlap_max
gqr:R-005 a sh:NodeShape ;
    gqr:param "item_terrain_overlap_max" ;
    gqr:measures [ gqr:measurement gq:OverlapRatio ; gqr:subject gq:LooseObject ] ;
    sh:targetClass gq:LooseObject ;
    sh:sparql [
        sh:prefixes gqr:prefixes ;
        sh:message "R-005 {$this}" ;
        sh:select """
            SELECT $this WHERE {
                ?m gq:measuredSubject $this ; a gq:OverlapRatio ; gq:value ?v .
                ?p gqr:name "item_terrain_overlap_max" ; gqr:value ?max .
                FILTER (?v > ?max)
            }""" ] .

# R-006: GroundedObject o에 대해 support_gap(o) > support_gap_max
#   제외: foreground_coverage(o) ≥ foreground_cover_min
gqr:R-006 a sh:NodeShape ;
    gqr:param "support_gap_max", "foreground_cover_min" ;
    gqr:measures [ gqr:measurement gq:SupportGap ; gqr:subject gq:GroundedObject ] ,
                 [ gqr:measurement gq:ForegroundCoverage ; gqr:subject gq:GroundedObject ] ;
    sh:targetClass gq:GroundedObject ;
    sh:sparql [
        sh:prefixes gqr:prefixes ;
        sh:message "R-006 {$this}" ;
        sh:select """
            SELECT $this WHERE {
                ?m gq:measuredSubject $this ; a gq:SupportGap ; gq:value ?v .
                ?p1 gqr:name "support_gap_max" ; gqr:value ?max .
                ?p2 gqr:name "foreground_cover_min" ; gqr:value ?cover .
                FILTER (?v > ?max)
                FILTER NOT EXISTS {
                    ?f gq:measuredSubject $this ; a gq:ForegroundCoverage ; gq:value ?c .
                    FILTER (?c >= ?cover)
                }
            }""" ] .

# R-008: attachedTo(q, c)에 대해 edge_distance(q, c) > equip_gap_max
gqr:R-008 a sh:NodeShape ;
    gqr:param "equip_gap_max" ;
    gqr:measures [ gqr:measurement gq:EdgeDistance ; gqr:subject gq:Equipment ; gqr:object gq:Character ] ;
    sh:targetClass gq:Equipment ;
    sh:sparql [
        sh:prefixes gqr:prefixes ;
        sh:message "R-008 {$this} {?c}" ;
        sh:select """
            SELECT $this ?c WHERE {
                $this gq:attachedTo ?c .
                ?m gq:measuredSubject $this ; a gq:EdgeDistance ; gq:measuredObject ?c ; gq:value ?v .
                ?p gqr:name "equip_gap_max" ; gqr:value ?max .
                FILTER (?v > ?max)
            }""" ] .

# R-009: 두 HUDElement a, b에 대해 hud_overlap_min < mutual_overlap(a, b) < hud_contain_min
#   측정값 방향과 무관하게 인스턴스 id 순으로 쌍마다 1건
gqr:R-009 a sh:NodeShape ;
    gqr:param "hud_overlap_min", "hud_contain_min" ;
    gqr:measures [ gqr:measurement gq:MutualOverlap ; gqr:subject gq:HUDElement ; gqr:object gq:HUDElement ; gqr:symmetric true ] ;
    sh:targetClass gq:HUDElement ;
    sh:sparql [
        sh:prefixes gqr:prefixes ;
        sh:message "R-009 {$this} {?b}" ;
        sh:select """
            SELECT $this ?b WHERE {
                { ?m gq:measuredSubject $this ; a gq:MutualOverlap ; gq:measuredObject ?b ; gq:value ?v }
                UNION
                { ?m gq:measuredSubject ?b ; a gq:MutualOverlap ; gq:measuredObject $this ; gq:value ?v }
                FILTER (xsd:integer(STRAFTER(STR($this), "instance:")) < xsd:integer(STRAFTER(STR(?b), "instance:")))
                ?p1 gqr:name "hud_overlap_min" ; gqr:value ?low .
                ?p2 gqr:name "hud_contain_min" ; gqr:value ?high .
                FILTER (?v > ?low && ?v < ?high)
            }""" ] .

# R-010 조건 1: belongsTo(x, p)인 p에 대해 contain_ratio(p, x) < text_contain_min
gqr:R-010-contain a sh:NodeShape ;
    gqr:param "text_contain_min" ;
    gqr:measures [ gqr:measurement gq:ContainRatio ; gqr:subject gq:UIPanel ; gqr:object gq:TextLabel ] ;
    sh:targetClass gq:TextLabel ;
    sh:sparql [
        sh:prefixes gqr:prefixes ;
        sh:message "R-010 {$this} {?p}" ;
        sh:select """
            SELECT $this ?p WHERE {
                $this gq:belongsTo ?p .
                ?m gq:measuredSubject ?p ; a gq:ContainRatio ; gq:measuredObject $this ; gq:value ?v .
                ?q gqr:name "text_contain_min" ; gqr:value ?min .
                FILTER (?v < ?min)
            }""" ] .

# R-010 조건 2: belongsTo(x, p)인 p에 대해 touches(x, p)
gqr:R-010-panel-edge a sh:NodeShape ;
    sh:targetClass gq:TextLabel ;
    sh:sparql [
        sh:prefixes gqr:prefixes ;
        sh:message "R-010 {$this} {?p}" ;
        sh:select """
            SELECT $this ?p WHERE {
                $this gq:belongsTo ?p ; gq:touches ?p .
            }""" ] .

# R-010 조건 3: touches(x, ScreenBounds)
gqr:R-010-screen-edge a sh:NodeShape ;
    sh:targetClass gq:TextLabel ;
    sh:sparql [
        sh:prefixes gqr:prefixes ;
        sh:message "R-010 {$this} {?s}" ;
        sh:select """
            SELECT $this ?s WHERE {
                $this gq:touches ?s .
                ?s a gq:ScreenBounds .
            }""" ] .
