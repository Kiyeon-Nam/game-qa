{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "판정 리포트",
  "description": "프레임 하나의 위반 목록. 의미 규칙은 schemas/README.md",
  "type": "object",
  "required": ["frame", "violations"],
  "properties": {
    "frame": {
      "type": "object",
      "required": ["source", "index"],
      "properties": {
        "source": {"type": "string"},
        "index": {"type": "integer", "minimum": 0}
      }
    },
    "violations": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["rule", "targets"],
        "properties": {
          "rule": {"type": "string", "pattern": "^R-[0-9]{3}$"},
          "targets": {
            "type": "array",
            "minItems": 1,
            "items": {
              "oneOf": [
                {"type": "integer"},
                {"const": "ScreenBounds"}
              ]
            }
          }
        }
      }
    }
  }
}
